{
  "name": "uav-platform-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "network:dev": "node ../scripts/network-studio/dev.mjs",
    "network:real": "node ../scripts/network-studio/dev.mjs --real",
    "network:serve": "node ../scripts/network-studio/serve.mjs",
    "test:network-core": "node --test ../scripts/network-studio/gateway-relay.test.mjs ../scripts/network-studio/engineering-relay.test.mjs ../scripts/network-studio/serve.test.mjs",
    "test:network-mock": "node --test ../scripts/network-studio/mock.test.mjs ../scripts/network-studio/gateway-relay.test.mjs",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "leaflet": "^1.9.4",
    "maplibre-gl": "4.7.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
