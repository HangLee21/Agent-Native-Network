[Unit]
Description=MID local board %i with optional LoRa control
After=local-fs.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=mid-edge
Group=dialout
SupplementaryGroups=mid-edge
ExecStart=/opt/mid-edge/venv/bin/python -m tools.mid_edge.board_service --config /etc/mid-edge/boards/%i.json --state /var/lib/mid-edge-%i
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5
TimeoutStopSec=15
StateDirectory=mid-edge-%i
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
