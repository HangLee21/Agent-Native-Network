/* ---- proactive route warm-up ------------------------------------------------
 * Before this, a multi-hop route existed only after a business packet found no
 * cached path (sr_submit -> RREQ).  After a power-on that meant the node had a
 * neighbour graph but no routes until the generator happened to pick a
 * non-adjacent destination, and an expired route (SR_CACHE_MS) stayed down until
 * the next packet.  This keeps the intended destinations warm with no business
 * traffic at all: at most one sr_query per WARM_TICK_MS, only when a route is
 * missing or about to expire, never for a direct neighbour (one hop needs no
 * route) and never for the PC service when this board already holds the lease
 * (that path is direct IP).  Warm-up only reuses the existing bounded RREQ; it
 * adds no new frame type and does not widen SR_ROUNDS/SR_DEADLINE.
 * ------------------------------------------------------------------------- */
#define WARM_SLOTS 10u
#define WARM_TICK_MS 500u
#define WARM_KEEP_MS 4000u
#define WARM_RETRY_MS 5000u
typedef struct {mid_id dst;uint64_t next_at;} warm_entry;
static warm_entry warm[WARM_SLOTS];
static unsigned warm_n,warm_cursor,warm_sig;
static int warm_built;
static unsigned warm_queries,warm_hits,warm_misses;
static int warm_known(mid_id dst){for(unsigned i=0;i<warm_n;i++)if(mid_equal(warm[i].dst,dst))return 1;return 0;}
static void warm_add(mid_id dst){
 if(warm_n==WARM_SLOTS||warm_known(dst)||mid_equal(dst,self)||!mid_unicast(dst))return;
 warm[warm_n].dst=dst;warm[warm_n].next_at=0;warm_n++;
}
static void warm_build(uint64_t now){
 unsigned sig=(uint32_t)(agent.cfg.roster_n*2654435761u)^(uint32_t)(gateway.agent_to_pc?gateway.pc_id:0);
 for(unsigned i=0;i<agent.cfg.roster_n;i++)sig=sig*31u+(((uint32_t)agent.cfg.roster[i].mac[4]<<8)|agent.cfg.roster[i].mac[5]);
 if(warm_built&&sig==warm_sig)return;
 warm_built=1;warm_sig=sig;warm_n=warm_cursor=0;
 for(unsigned i=0;i<agent.cfg.roster_n;i++)warm_add(agent.cfg.roster[i]);
 if(gateway.agent_to_pc&&gateway.pc_id&&!field_ip_live(now))warm_add(fg_service(gateway.pc_id));
}
static int warm_remaining(mid_id dst,uint64_t now){
 int best=-1;
 for(unsigned i=0;i<SR_ROUTES;i++){sr_route*r=&router.routes[i];if(!r->used||!mid_equal(r->dst,dst))continue;
  int left=r->until>now?(int)(r->until-now):0;if(left>best)best=left;}
 return best;
}
static void field_warm_tick(void){
 if(!active||!route_mode||!have_discovery)return;
 uint64_t now=millis();warm_build(now);if(!warm_n)return;
 for(unsigned k=0;k<warm_n;k++){
  unsigned i=(warm_cursor+k)%warm_n;
  if(warm[i].next_at>now)continue;
  warm_cursor=(i+1)%warm_n;
  mid_id dst=warm[i].dst;
  if(nd_direct(&neighbors,dst,0,now)){warm[i].next_at=now+WARM_KEEP_MS;warm_hits++;return;}
  if(warm_remaining(dst,now)>(int)WARM_KEEP_MS){warm[i].next_at=now+WARM_KEEP_MS;warm_hits++;return;}
  int r=sr_query(&router,dst,now);
  if(r==1){warm[i].next_at=now+WARM_KEEP_MS;warm_hits++;}
  else if(r==0){warm[i].next_at=now+WARM_TICK_MS;warm_queries++;}
  else{warm[i].next_at=now+WARM_RETRY_MS;warm_misses++;}
  return;
 }
}
