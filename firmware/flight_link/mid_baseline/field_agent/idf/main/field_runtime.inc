static fr_state reliable;
typedef struct {int used;mid_id dst;uint8_t bytes[160];size_t len;unsigned attempts;uint64_t next,until;} fr_ack_job;
static fr_ack_job reliable_ack[4];static uint32_t reliable_ack_full,reliable_ack_failed;
static int field_submit(mid_id,const uint8_t*,unsigned);
static void field_hex(cJSON*,const char*,const uint8_t*,unsigned);
static int reliable_send_adapter(void*ctx,const uint8_t dst[6],const uint8_t*b,size_t len){(void)ctx;mid_id id;memcpy(id.mac,dst,6);fr_route_before(&reliable,&router,b,len,millis());int result=field_submit(id,b,(unsigned)len);if(!result)fr_route_submitted(&reliable,b,len,field_last_seq);return result;}
static void reliable_timeout_adapter(void*ctx,const fr_message*m){(void)ctx;cJSON*j=event("reliable_timeout");cJSON_AddNumberToObject(j,"message_id",m->id);cJSON_AddNumberToObject(j,"origin_boot",m->origin_boot);cJSON_AddNumberToObject(j,"dst_boot",m->dst_boot);mid_id dst;memcpy(dst.mac,m->dst,6);field_id(j,"dst",dst);cJSON_AddStringToObject(j,"outcome","unknown");cJSON_AddNumberToObject(j,"route_submissions",m->submissions);cJSON_AddNumberToObject(j,"local_submit_rejections",m->local_rejections);cJSON_AddBoolToObject(j,"destination_confirmed",false);output(j);}
static void reliable_tick(uint64_t now){
 fr_tick(&reliable,now,reliable_send_adapter,reliable_timeout_adapter,NULL);
 for(unsigned i=0;i<4;i++){fr_ack_job*q=&reliable_ack[i];if(!q->used||now<q->next)continue;if(now>=q->until||q->attempts>=2){q->used=0;reliable_ack_failed++;continue;}q->attempts++;if(field_submit(q->dst,q->bytes,(unsigned)q->len)==0)q->used=0;else q->next=now+250;break;}
}
static void field_reliable_receive(const sr_event*e){
 fr_message msg;uint8_t ack[160];size_t n=0;int r=fr_receive(&reliable,e->origin.mac,e->boot,e->payload,e->len,millis(),&msg,ack,&n);
 if(r==1){cJSON*j=event("reliable_received");field_id(j,"origin",e->origin);cJSON_AddNumberToObject(j,"origin_boot",msg.origin_boot);cJSON_AddNumberToObject(j,"destination_boot",msg.dst_boot);cJSON_AddNumberToObject(j,"message_id",msg.id);field_hex(j,"payload_hex",msg.payload,msg.len);output(j);}
 if(r==1||r==2){int stored=0;for(unsigned i=0;i<4;i++)if(!reliable_ack[i].used){fr_ack_job*q=&reliable_ack[i];memset(q,0,sizeof(*q));q->used=1;q->dst=e->origin;memcpy(q->bytes,ack,n);q->len=n;q->next=millis();q->until=q->next+3000;stored=1;break;}if(!stored)reliable_ack_full++;}
 if(r==3){
#if MID_ROUTE_FEEDBACK
  if(msg.route_seq)sr_confirmed(&router,msg.route_seq,millis());
#endif
  cJSON*j=event("reliable_delivered");mid_id dst;memcpy(dst.mac,msg.dst,6);field_id(j,"dst",dst);cJSON_AddNumberToObject(j,"message_id",msg.id);cJSON_AddNumberToObject(j,"origin_boot",msg.origin_boot);cJSON_AddNumberToObject(j,"destination_boot",msg.dst_boot);cJSON_AddBoolToObject(j,"destination_confirmed",true);output(j);}
}
/* Rounded upward by 1ms; capped values never grant fresh evidence. */
static uint32_t field_neighbor_age(uint64_t now,uint64_t at,uint32_t cap){
 if(at>now||now-at>=cap)return cap;
 return (uint32_t)(now-at)+1;
}
static void field_neighbor_query(uint32_t query_id){
 static uint32_t last_session,last_id;static uint64_t last_at;static int have_reply;
 uint64_t now=millis();uint32_t current=field_ip_session();
 cJSON*j=cJSON_CreateObject();field_ip_base(j,"neighbors");cJSON_AddNumberToObject(j,"query_id",query_id);
 if(current!=last_session){last_session=current;last_id=0;have_reply=0;}
 const char*error=NULL;
 if(!query_id||query_id<=last_id)error="old_query";
 else if(have_reply&&(now<last_at||now-last_at<500))error="rate_limited";
 if(error){cJSON_AddBoolToObject(j,"ok",false);cJSON_AddStringToObject(j,"error",error);field_ip_emit(j,0);return;}
 cJSON_AddStringToObject(j,"encoding","nd.rf.v1");cJSON_AddNumberToObject(j,"snapshot_at_ms",(double)now);
 cJSON_AddNumberToObject(j,"confirm_ms",ND_CONFIRM_MS);cJSON_AddNumberToObject(j,"lost_ms",ND_LOST_MS);cJSON_AddNumberToObject(j,"nd_full",neighbors.full);
 cJSON*rows=cJSON_AddArrayToObject(j,"rows");
 for(unsigned i=0;i<ND_PEERS;i++){
  nd_peer*p=&neighbors.peers[i];if(!p->used||!p->boot||!allowed(p->id))continue;
  mt_rf*rf=NULL;for(unsigned k=0;k<MT_ROWS;k++)if(mobile.rf[k].used&&mid_equal(mobile.rf[k].peer,p->id)){rf=&mobile.rf[k];break;}
  cJSON*r=cJSON_CreateArray();char mac[18];mac_text(p->id,mac);
  cJSON_AddItemToArray(r,cJSON_CreateString(mac));cJSON_AddItemToArray(r,cJSON_CreateNumber(p->boot));
  cJSON_AddItemToArray(r,cJSON_CreateNumber(nd_state(p,now)));cJSON_AddItemToArray(r,cJSON_CreateNumber(field_neighbor_age(now,p->seen,ND_LOST_MS)));
  cJSON_AddItemToArray(r,p->confirmed?cJSON_CreateNumber(field_neighbor_age(now,p->ack,ND_CONFIRM_MS)):cJSON_CreateNull());
  int have_rf=rf&&rf->at<=now;
  cJSON_AddItemToArray(r,have_rf&&rf->rssi_valid?cJSON_CreateNumber(rf->rssi):cJSON_CreateNull());
  cJSON_AddItemToArray(r,have_rf?cJSON_CreateNumber(field_neighbor_age(now,rf->at,ND_LOST_MS)):cJSON_CreateNull());
  cJSON_AddItemToArray(r,have_rf&&rf->channel_valid?cJSON_CreateNumber(rf->channel):cJSON_CreateNull());
  if(!r||cJSON_GetArraySize(r)!=8||!rows){cJSON_Delete(r);cJSON_Delete(j);return;}
  cJSON_AddItemToArray(rows,r);
 }
 cJSON_AddBoolToObject(j,"ok",true);last_id=query_id;last_at=now;have_reply=1;field_ip_emit(j,0);
}
