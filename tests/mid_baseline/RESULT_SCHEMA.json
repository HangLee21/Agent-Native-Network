{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MID validation analysis (proposed normalized contract)",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "evidence_kind",
    "streams",
    "issues",
    "display_issues",
    "source_logs",
    "source_config",
    "analyzer_sha256"
  ],
  "properties": {
    "schema": {
      "const": "mid.validation.analysis.v1"
    },
    "run_id": {
      "type": "string"
    },
    "evidence_kind": {
      "enum": [
        "synthetic",
        "hardware_measured"
      ]
    },
    "streams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "flow_id",
          "source_id",
          "destination_id",
          "pdr",
          "goodput_bps",
          "rtt_p95_ms",
          "issues"
        ],
        "properties": {
          "pdr": {
            "type": [
              "number",
              "null"
            ]
          },
          "goodput_bps": {
            "type": [
              "number",
              "null"
            ]
          },
          "rtt_p95_ms": {
            "type": [
              "number",
              "null"
            ]
          },
          "airtime_us": {
            "type": [
              "number",
              "null"
            ]
          },
          "rf_retry_count": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "issues": {
      "type": "array"
    },
    "display_issues": {
      "type": "array"
    },
    "source_logs": {
      "type": "array"
    },
    "source_config": {
      "type": "object"
    },
    "analyzer_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
